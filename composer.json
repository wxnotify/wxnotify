{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "anselmokossa/filament-sentinel": "^1.2",
        "awcodes/filament-gravatar": "^4.2",
        "cerealkiller97/filament-bug-reports": "^1.0",
        "clickbar/laravel-magellan": "^2.2",
        "coderflex/filament-turnstile": "^4.0",
        "dutchcodingcompany/filament-developer-logins": "^2.1",
        "dutchcodingcompany/filament-socialite": "^3.2",
        "eightcedars/filament-inactivity-guard": "^1.1",
        "fahiem/filament-pinpoint": "^1.1",
        "filament/filament": "^5.0",
        "guava/filament-knowledge-base": "^3.3",
        "jeffersongoncalves/filament-cookie-consent": "^3.2",
        "jeffersongoncalves/filament-logo": "^3.0",
        "jeffersongoncalves/filament-one-time-operations": "^3.1",
        "jeffersongoncalves/filament-service-desk": "^3.0",
        "johnrivera7/filament-cybersecurity": "^1.0",
        "laravel-notification-channels/webpush": "^13.0",
        "laravel/framework": "^13.17",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "marcelodelgado/filament-announcements": "^1.0",
        "owenvoke/blade-fontawesome": "^3.3",
        "phpmyadmin/shapefile": "^4.0",
        "shuvroroy/filament-spatie-laravel-health": "^3.3",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-webhook-server": "^3.11",
        "ssbityukov/filament-command-center": "^1.0",
        "stechstudio/filament-impersonate": "^5.6",
        "swisnl/filament-backgrounds": "^2.0",
        "symfony/css-selector": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "tapp/filament-timezone-field": "^3.1",
        "tonegabes/filament-better-options": "^1.4",
        "wallacemartinss/filament-onboarding": "^2.1"
    },
    "require-dev": {
        "brianium/paratest": "^7.24",
        "fakerphp/faker": "^1.23",
        "filament/blueprint": "^2.2",
        "laravel/boost": "^2.7",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "filament",
        "type": "composer",
        "url": "https://packages.filamentphp.com/composer"
    }]
}
