APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Match the container's www-data uid/gid to your own (`id -u`/`id -g`) so
# bind-mounted files stay owned by you, not root. This is a BUILD-time-only
# setting for the serversideup/php images (docker/8.4/Dockerfile) -- unlike
# Sail's old runtime WWWUSER/WWWGROUP, changing these requires a rebuild
# (`docker compose build front-end pipeline-api queue queue-heartbeat`).
USER_ID=1000
GROUP_ID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WXNOTIFY_MODE=cloud
WXNOTIFY_WEBHOOKS_ALLOW_PRIVATE=false
# Optional: serve public View Product pages from a dedicated host; unset serves from the main domain.
WXNOTIFY_PRODUCT_DOMAIN=

# Client IP behind a load balancer or Cloudflare (both off by default: the connecting
# address is the client and forwarding headers are ignored). TRUSTED_PROXIES is `*` or a
# comma list of proxy IPs/CIDRs whose X-Forwarded-For is believed, application-wide.
# CLIENT_IP_HEADER=CF-Connecting-IP prefers Cloudflare's header (only from a trusted proxy;
# list Cloudflare's published ranges above and make sure the origin is reachable only via Cloudflare).
WXNOTIFY_TRUSTED_PROXIES=
WXNOTIFY_CLIENT_IP_HEADER=

APPRISE_API_URL=http://apprise:8000

PINPOINT_PROVIDER=leaflet
GOOGLE_MAPS_DEFAULT_LAT=39.8283
GOOGLE_MAPS_DEFAULT_LNG=-98.5795

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/dashboard/oauth/callback/google"

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_IDENTITY_SECRET=

NWWS_USERNAME=
NWWS_PASSWORD=
# Days to keep NWWS product files on the volume (whole number, 1 or more)
NWWS_RETENTION_DAYS=7

PIPELINE_WEBHOOK_TOKEN=
PIPELINE_PRODUCTS_PATH=/products
PIPELINE_EMWIN_PRODUCTS_PATH=/emwin-products
EMWIN_WEB_PORT=8016
PIPELINE_API_PORT=8027
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

# Compose profile groups (see compose.yaml's top comment): server-a is the
# dashboard, server-b is Postgres/Redis, server-c is the pipeline clients +
# pipeline-api + queue workers, support is Healthchecks. All four by default
# so `docker compose up` behaves the same as before profiles existed; drop
# server-a here (or export a narrower COMPOSE_PROFILES for one invocation) to
# run the alert engine without the dashboard.
COMPOSE_PROFILES=server-a,server-b,server-c,support

FOOTER_COMPANY_NAME="${APP_NAME}"
FOOTER_COMPANY_URL="${APP_URL}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=
TRACCAR_POLLING_TOKEN=

# Apple WeatherKit (mobile Weather card). Leave blank to disable the card.
# Team ID: Apple Developer portal > Membership details.
# WEATHERKIT_TEAM_ID=
# Service ID: Certificates, Identifiers & Profiles > Identifiers > Services IDs (WeatherKit enabled).
# WEATHERKIT_SERVICE_ID=
# Key ID: Certificates, Identifiers & Profiles > Keys > the key with WeatherKit enabled.
# WEATHERKIT_KEY_ID=
# The .p8 private key text for that key (newlines may be written as \n); or use the path below instead.
# WEATHERKIT_PRIVATE_KEY=
# Path to the downloaded AuthKey_XXXX.p8 file, readable by the app.
# WEATHERKIT_PRIVATE_KEY_PATH=
