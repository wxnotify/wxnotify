# WxNotify, single server. Copy to .env next to compose.yaml and fill in what is marked.
# Settings are listed in the order you will meet them. Anything not listed keeps a safe default.

# --- Release -------------------------------------------------------------------
# Required. The exact release to run, for example 1.2.3: find the current one on the
# releases page. Pinned on purpose, so upgrades happen when you change this. (1.2, 1 and
# latest also exist, for people who choose to follow along.)
WXNOTIFY_VERSION=
# Where the images come from. Leave commented to use the default (wxnotify).
# WXNOTIFY_REGISTRY=wxnotify

# --- Application ---------------------------------------------------------------
APP_NAME=WxNotify
APP_ENV=production
APP_DEBUG=false
# Self-hosted instance (the other value, cloud, is the hosted service: it shows the
# Billing page and the billing/support-chat setup steps, and keeps the private-network
# relaxations below off). Every account starts on the Free tier either way; an owner
# gives an account Plus or Pro under Admin > Users > edit > Tier override.
WXNOTIFY_MODE=selfhost
# selfhost only: let webhook and chat-server channels deliver to private-network
# addresses (services on your own LAN). Off unless you set it.
# WXNOTIFY_WEBHOOKS_ALLOW_PRIVATE=true
# The address people use in their browser, with no trailing slash. Plain HTTP works for a
# trial; put a TLS reverse proxy in front for real use (see "Behind an HTTPS reverse
# proxy" at the end of this file). An https:// value makes every generated URL https.
APP_URL=http://localhost:8080
# The port the dashboard is published on.
APP_PORT=8080
# Generate with:  docker run --rm ${WXNOTIFY_REGISTRY:-wxnotify}/wxnotify:<version> php artisan key:generate --show | tail -n 1
# (the image prints a banner first; the key is the last line, starting with base64:).
# Generate it once and never change it: channel credentials are encrypted with it.
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (PostgreSQL runs in this stack) ----------------------------------
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=wxnotify
DB_USERNAME=wxnotify
# Generate with:  openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=

# Sessions, cache and the queue all live in the database.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Live updates (Reverb WebSockets) ------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=wxnotify
# Generate each with:  openssl rand -hex 16   (secret: openssl rand -hex 32)
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The host port the WebSocket server is published on (your reverse proxy forwards /app and /apps to it).
REVERB_PUBLISHED_PORT=8085
# Where the BROWSER connects. Leave the host unset to use the host the page was loaded
# from. Behind an HTTPS reverse proxy set the port to 443 and the scheme to https.
# REVERB_PUBLIC_HOST=wxnotify.example.com
REVERB_PUBLIC_PORT=8085
REVERB_PUBLIC_SCHEME=http
# Hostnames (no scheme or port) browsers may open a WebSocket from; defaults to the APP_URL host.
# REVERB_ALLOWED_ORIGINS=wxnotify.example.com

# --- Weather feeds -------------------------------------------------------------
# Shared by the dashboard and the feed containers.
# Generate with:  openssl rand -hex 32
PIPELINE_WEBHOOK_TOKEN=
# Optional: your NWWS-OI account (leave empty to run without the NWWS feed).
NWWS_USERNAME=
NWWS_PASSWORD=
# Days to keep product files on disk (whole number, 1 or more).
NWWS_RETENTION_DAYS=7
EMWIN_RETENTION_DAYS=7
EMWIN_SERVERS_REFRESH_HOURS=6
EMWIN_MAX_UNZIP_BYTES=5242880

# --- Sign-up protection (Cloudflare Turnstile) --------------------------------
# Optional. With WXNOTIFY_MODE=selfhost (set in this file) and BOTH keys blank, sign-up works
# without a captcha. To keep automated sign-ups out of a site anyone can reach, create a free
# Cloudflare account, open Turnstile, add a site for your hostname and paste its site key and
# secret key here. Set both or
# neither: with only one set the captcha still applies and sign-up fails until both are filled.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mail ----------------------------------------------------------------------
# Sign-up sends a verification email, and password resets and email alerts send mail too.
# Until real delivery is set up, MAIL_MAILER=mailpit sends everything to the Mailpit
# container in this stack instead: nothing leaves your server, and you read each message
# (verification links included) at http://localhost:8025. Over SSH, tunnel it:
#   ssh -L 8025:localhost:8025 you@your-server
# The page is not password-protected, so it listens on this host's loopback only (see
# MAILPIT_BIND_ADDRESS below before changing that). The Setup checklist's
# "Set up outgoing email" step stays open until you switch to a real mailer.
#
# For real delivery, set MAIL_MAILER=smtp and fill in your provider's details (a username
# and password, usually on port 587), then run `docker compose up -d` again:
MAIL_MAILER=mailpit
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# The host port for the Mailpit page (default 8025).
# MAILPIT_PORT=8025
# Which host address the Mailpit page listens on. Leave it on loopback: anyone who can
# reach the page can read every email, including password-reset links.
# MAILPIT_BIND_ADDRESS=127.0.0.1

# --- Outlook map images --------------------------------------------------------
# "local" stores them on the app-storage volume, which suits one server.
OUTLOOK_MAPS_DISK=local

# --- Behind an HTTPS reverse proxy --------------------------------------------
# A plain-HTTP trial leaves this section alone. With a TLS proxy (Caddy, nginx) on this
# host, set APP_URL above to the public https:// address and uncomment all of these
# (see the README's HTTPS section):
#   APP_BIND_ADDRESS / REVERB_BIND_ADDRESS: publish 8080 and 8085 on loopback only, so
#     nobody can reach the app around the proxy (Docker's ports bypass ufw/firewalld).
#   SESSION_SECURE_COOKIE: the session cookie is sent over HTTPS only.
#   WXNOTIFY_TRUSTED_PROXIES: believe the proxy's X-Forwarded-For/-Proto. Needed for real
#     client IPs (rate limits, logs) and for signed links (email verification) to
#     validate. `*` is safe ONLY while both ports are bound to 127.0.0.1; otherwise list
#     the proxy's address as the container sees it (see the README).
# APP_BIND_ADDRESS=127.0.0.1
# REVERB_BIND_ADDRESS=127.0.0.1
# SESSION_SECURE_COOKIE=true
WXNOTIFY_TRUSTED_PROXIES=
# CF-Connecting-IP when behind Cloudflare.
WXNOTIFY_CLIENT_IP_HEADER=
