# WxNotify, four servers. The same compose.yaml goes on every server; each server gets its
# own .env copied from this file. Settings are in the order you will meet them. "ALL" means
# the value must be identical wherever it appears (see the multi-server guide).

# --- Which server is this? -----------------------------------------------------
# server-a (dashboard + reverb), server-b (database), server-c (ingestion), server-d (delivery).
COMPOSE_PROFILES=server-a

# --- Release (every server) ----------------------------------------------------
# The image version to run, for example 1.0.0. Required, and the same on every server.
WXNOTIFY_VERSION=latest
# Where the images come from. Leave commented to use the default (wxnotify).
# WXNOTIFY_REGISTRY=wxnotify

# --- Application (A, C, D) -----------------------------------------------------
APP_NAME=WxNotify
APP_ENV=production
APP_DEBUG=false
# The public address people use, with no trailing slash (behind your TLS proxy).
APP_URL=https://wxnotify.example.com
# The port the dashboard is published on (server A).
APP_PORT=8080
# Generate ONCE, on any machine, and copy it to A, C and D:
#   docker run --rm ${WXNOTIFY_REGISTRY:-wxnotify}/wxnotify:<version> php artisan key:generate --show | tail -n 1
# (the image prints a banner first; the key is the last line, starting with base64:).
# Never change it: channel credentials are encrypted with it.
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (A, B, C, D; B runs it) ------------------------------------------
DB_CONNECTION=pgsql
# The address of server B on the private network (not used on B itself).
DB_HOST=10.0.0.2
DB_PORT=5432
DB_DATABASE=wxnotify
DB_USERNAME=wxnotify
# Generate with:  openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=
# B only: the private address the database listens on. Never a public address.
DB_BIND_ADDRESS=127.0.0.1
# B only, and only if you use Redis.
REDIS_BIND_ADDRESS=127.0.0.1

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Live updates (Reverb): A and D --------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=wxnotify
# Generate each with:  openssl rand -hex 16   (secret: openssl rand -hex 32)
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the application's own servers send broadcasts (not where browsers connect).
# On A: reverb / 8080 / http. On D: server A's private address, 8085, http.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# A only: the private address the WebSocket server listens on, and its published port.
REVERB_BIND_ADDRESS=127.0.0.1
REVERB_PUBLISHED_PORT=8085
# A only: where the BROWSER connects (your public hostname behind the TLS proxy).
# REVERB_PUBLIC_HOST=wxnotify.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
# Hostnames browsers may open a WebSocket from; defaults to the APP_URL host.
# REVERB_ALLOWED_ORIGINS=wxnotify.example.com

# --- Weather feeds (A and C) ---------------------------------------------------
# Generate with:  openssl rand -hex 32   (the same value on A and C)
PIPELINE_WEBHOOK_TOKEN=
# C only: your NWWS-OI account (leave empty to run without the NWWS feed).
NWWS_USERNAME=
NWWS_PASSWORD=
NWWS_RETENTION_DAYS=7
EMWIN_RETENTION_DAYS=7
EMWIN_SERVERS_REFRESH_HOURS=6
EMWIN_MAX_UNZIP_BYTES=5242880
# C only: loopback ports for the pipeline API and the EMWIN web view.
PIPELINE_API_PORT=8027
EMWIN_WEB_PORT=8016

# --- Docker control (A calls C) ------------------------------------------------
# C only: the private address the Docker proxy listens on. Firewall it to A alone.
DOCKER_PROXY_BIND_ADDRESS=127.0.0.1
# A only: where server A reaches it, e.g. http://10.0.0.3:2375
DOCKER_PROXY_URL=http://10.0.0.3:2375

# --- Apprise (D, called by A) --------------------------------------------------
# D only: the private address Apprise listens on. Firewall it to A and D.
APPRISE_BIND_ADDRESS=127.0.0.1
# A: http://<D's private address>:8026.  D: http://apprise:8000
APPRISE_API_URL=http://10.0.0.4:8026

# --- Mail (A and D) ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Outlook map images (A and D) ----------------------------------------------
# D writes them and A reads them, so they need shared storage: an S3-compatible bucket
# (the example is Backblaze B2). The same values on A and D.
OUTLOOK_MAPS_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-004
AWS_BUCKET=
AWS_ENDPOINT=https://s3.us-west-004.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Behind a proxy (A) --------------------------------------------------------
WXNOTIFY_TRUSTED_PROXIES=
WXNOTIFY_CLIENT_IP_HEADER=
